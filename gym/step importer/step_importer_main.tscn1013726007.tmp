[sub_resource type="GDScript" id="GDScript_etd0p"]
script/source = "extends Node3D

func _ready() -> void:
	# Load the .step data file path resource
	var file_path = \"res://gym/step importer/Клемма.step\"
	
	if FileAccess.file_exists(file_path):
		var file = FileAccess.open(file_path, FileAccess.READ)
		var step_string = file.get_as_text()
		file.close()
		
		# Generate the 3D Node
		var step_mesh_node = StepImporter.import_step_from_string(step_string)
		if step_mesh_node:
			add_child(step_mesh_node)
			# Re-center instance relative to camera positions inside the editor
			step_mesh_node.global_position = Vector3.ZERO 
			print(\"STEP Data node added successfully to Scene Tree.\")
	else:
		print(\"Error: Could not locate specified file path.\")
"

